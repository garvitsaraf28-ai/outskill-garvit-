# Copy this file to ".env" and fill in your key, then restart the server.
# Get a key at https://openrouter.ai/keys
# The .env file is gitignored and the key stays on the server — never in the browser.

OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides:
# Comma-separated fallback chain of FREE models (tried in order on rate-limit).
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_MAX_TOKENS=1024
# PORT=3001
