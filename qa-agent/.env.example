# Copy to .env (or export in your shell). The key stays server-side only.
# Option A (recommended for real events): Claude — console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Option B (free mode for testing): OpenRouter — openrouter.ai/keys (no card needed)
# Leave ANTHROPIC_API_KEY empty and set:
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional overrides (defaults shown)
# PORT=8787
# ANSWER_MODEL=claude-opus-4-8
# PROFILE_MODEL=claude-opus-4-8
# SUMMARY_MODEL=claude-opus-4-8
# ANSWER_MAX_TOKENS=4096
# PROFILE_TIMEOUT_MS=2500
# HISTORY_WINDOW=12
# RETRIEVE_K=6
# RATE_LIMIT_PER_MIN=20
